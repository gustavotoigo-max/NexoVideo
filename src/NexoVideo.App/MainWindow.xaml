<Window x:Class="NexoVideo.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="NexoVideo — análise e recuperação" Width="1440" Height="1000" MinWidth="1160" MinHeight="820" WindowStartupLocation="CenterScreen">
  <Grid Background="{DynamicResource Nx.Bg}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="256" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Nx.Navy}" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="0,0,1,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="24,0" VerticalAlignment="Center">
          <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Nx.AccentGradient}"><Image Source="Assets/Figma/brand.png" Width="16" Height="20" Stretch="Uniform" /></Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="NexoVideo" FontSize="16" FontWeight="Bold" Foreground="White" /><TextBlock Text="ANÁLISE E RECUPERAÇÃO" Foreground="{DynamicResource Nx.OnNavyMuted}" FontSize="9" Margin="0,4,0,0" /></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="16,0"><TextBlock Text="GERAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Nx.OnNavyMuted}" Margin="0,0,0,8" />
          <Button x:Name="Nav0" Tag="0" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Image Source="Assets/Figma/analysis.png" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="Análise de vídeos" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" /></StackPanel></Button>
          <Button x:Name="Nav1" Tag="1" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Image Source="Assets/Figma/recovery.png" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="Recuperação" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" /></StackPanel></Button>
          <Button x:Name="Nav2" Tag="2" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Image Source="Assets/Figma/reports.png" Width="20" Height="20" Stretch="Uniform" /><TextBlock Text="Relatórios" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" /></StackPanel></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="16,16,16,24">
          <Border BorderBrush="{DynamicResource Nx.Border}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
          <Button x:Name="Nav3" Tag="3" Style="{StaticResource Nav}" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20"><Image Source="Assets/Figma/settings-nav.png" Width="20.1" Height="20" Stretch="Fill" /></Grid><TextBlock Text="Configurações" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
          <Border Background="{DynamicResource Nx.Navy2}" CornerRadius="8" Padding="14" Margin="0,14,0,0"><StackPanel><TextBlock Foreground="{DynamicResource Nx.OnNavy}" FontSize="12" FontWeight="Medium" Text="Originais preservados" /><TextBlock Foreground="{DynamicResource Nx.OnNavyMuted}" FontSize="11" Margin="0,6,0,0" Text="Análise somente de leitura. Candidatos em uma pasta separada." /></StackPanel></Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource Nx.Bg}" BorderBrush="{DynamicResource Nx.Border}" BorderThickness="0,0,0,1" Padding="32,0">
        <DockPanel VerticalAlignment="Center"><Button DockPanel.Dock="Right" Content="Verificar atualizações" Style="{StaticResource Secondary}" IsEnabled="False" ToolTip="Disponível após o primeiro release formal e definição do fluxo de atualização." /><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="NexoVideo  /  " Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="HeaderLocation" Text="Análise de vídeos" FontWeight="Medium" FontSize="12" /><Border Background="{DynamicResource Nx.BlueSoft}" CornerRadius="4" Padding="7,3" Margin="14,-3,0,-3"><TextBlock Text="0.1.0-dev" FontSize="10" Foreground="{DynamicResource Nx.Blue}" /></Border></StackPanel></DockPanel>
      </Border>
      <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0">
        <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style></TabControl.Resources>
        <TabItem>
          <ScrollViewer x:Name="AnalysisScroller" Margin="32,28,32,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"><Grid Height="{Binding ViewportHeight, ElementName=AnalysisScroller}" MinHeight="820">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,19"><TextBlock Text="Análise de vídeos" FontSize="28" FontWeight="Bold" /><TextBlock Text="Identifique trilhas, examine o conteúdo e mantenha um histórico local do diagnóstico." Style="{StaticResource Muted}" Margin="0,5,0,0" /></StackPanel>
            <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,24">
              <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16" ToolTip="Estado da fila; não representa garantia de integridade."><StackPanel>
                <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="{DynamicResource Nx.InfoSoft}" CornerRadius="4" Padding="6,4" VerticalAlignment="Top"><TextBlock Text="TOTAL" Foreground="{DynamicResource Nx.InfoText}" FontWeight="Bold" FontSize="8" TextWrapping="NoWrap" /></Border><Border Background="{DynamicResource Nx.InfoSoft}" CornerRadius="8" Width="34" Height="34" HorizontalAlignment="Left"><Image Source="Assets/Figma/metric-total.png" Width="16" Height="20" Stretch="Uniform" /></Border></DockPanel>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="TotalCount" Text="0" FontSize="27" FontWeight="Bold" Margin="0,0,10,0" /><TextBlock Text="Arquivos na fila" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="Inventário da sessão" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16" ToolTip="Estado da fila; não representa garantia de integridade."><StackPanel>
                <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="{DynamicResource Nx.SuccessSoft}" CornerRadius="4" Padding="6,4" VerticalAlignment="Top"><TextBlock Text="CONCLUÍDO" Foreground="{DynamicResource Nx.SuccessText}" FontWeight="Bold" FontSize="8" TextWrapping="NoWrap" /></Border><Border Background="{DynamicResource Nx.SuccessSoft}" CornerRadius="8" Width="34" Height="34" HorizontalAlignment="Left"><Image Source="Assets/Figma/metric-completed.png" Width="22" Height="21" Stretch="Uniform" /></Border></DockPanel>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="CompletedCount" Text="0" FontSize="27" FontWeight="Bold" Margin="0,0,10,0" /><TextBlock Text="Análises concluídas" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="Processamento encerrado" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16" ToolTip="Estado da fila; não representa garantia de integridade."><StackPanel>
                <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="{DynamicResource Nx.DangerSoft}" CornerRadius="4" Padding="6,4" VerticalAlignment="Top"><TextBlock Text="ERROS" Foreground="{DynamicResource Nx.DangerText}" FontWeight="Bold" FontSize="8" TextWrapping="NoWrap" /></Border><Border Background="{DynamicResource Nx.DangerSoft}" CornerRadius="8" Width="34" Height="34" HorizontalAlignment="Left"><Image Source="Assets/Figma/metric-failed.png" Width="21.35" Height="21.225" Stretch="Fill" /></Border></DockPanel>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="FailedCount" Text="0" FontSize="27" FontWeight="Bold" Margin="0,0,10,0" /><TextBlock Text="Falhas de execução" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="Consulte o diagnóstico" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="6,0" Padding="20,16" ToolTip="Estado da fila; não representa garantia de integridade."><StackPanel>
                <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Background="{DynamicResource Nx.WarningSoft}" CornerRadius="4" Padding="6,4" VerticalAlignment="Top"><TextBlock Text="NA FILA" Foreground="{DynamicResource Nx.WarningText}" FontWeight="Bold" FontSize="8" TextWrapping="NoWrap" /></Border><Border Background="{DynamicResource Nx.WarningSoft}" CornerRadius="8" Width="34" Height="34" HorizontalAlignment="Left"><Image Source="Assets/Figma/metric-pending.png" Width="18" Height="20" Stretch="Uniform" /></Border></DockPanel>
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="PendingCount" Text="0" FontSize="27" FontWeight="Bold" Margin="0,0,10,0" /><TextBlock Text="Pendentes" FontSize="11" VerticalAlignment="Center" /></StackPanel>
                <TextBlock Text="Aguardando processamento" Style="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" />
              </StackPanel></Border>
            </UniformGrid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,24">
              <StackPanel><Grid x:Name="ScanInputs"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="230" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="PASTA DE ORIGEM" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="0,0,0,7" /><TextBlock Grid.Column="1" Text="MODO DE ANÁLISE" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="18,0,0,7" />
                <DockPanel Grid.Row="1"><Button DockPanel.Dock="Right" Content="Procurar" Style="{StaticResource Secondary}" Click="Source_Click" Margin="8,0,0,0" /><TextBox x:Name="SourceBox" ToolTip="Pasta que contém os vídeos" /></DockPanel>
                <ComboBox x:Name="ModeBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="18,0,0,0"><ComboBoxItem Content="Rápido · estrutura" /><ComboBoxItem Content="Intermediário · amostras" /><ComboBoxItem Content="Completo · decodificação" /></ComboBox>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0"><DockPanel><Button DockPanel.Dock="Right" Content="Marcar todos" Style="{StaticResource Secondary}" Padding="10,4" Click="AllFormats_Click" /><TextBlock Text="FORMATOS" FontSize="10" FontWeight="SemiBold" Style="{StaticResource Muted}" VerticalAlignment="Center" /></DockPanel><WrapPanel x:Name="FormatsPanel" Margin="0,4,0,0" /><TextBlock Style="{StaticResource Muted}" FontSize="11" Text="* Análise experimental, sem controle sintético homologado. Detecção não garante reparo." /></StackPanel>
              </Grid>
              <DockPanel Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ResumeButton" Content="Retomar fila" Click="Resume_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0" /><Button x:Name="StartButton" Content="Iniciar análise" Click="Start_Click" /></StackPanel><TextBlock Text="Um vídeo por vez · resultados persistidos antes do próximo" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center" /></DockPanel>
              </StackPanel>
            </Border>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition Height="*" /><RowDefinition Height="45" /></Grid.RowDefinitions>
              <DockPanel Margin="18,0"><TextBlock Text="Resultados da sessão" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="PageLabel" Text="Página 1" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
              <DataGrid x:Name="ResultsGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="Results_SelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="ARQUIVO" ElementStyle="{StaticResource TableText}" Binding="{Binding Name}" Width="1.1*" /><DataGridTextColumn Header="TAMANHO" ElementStyle="{StaticResource TableText}" Binding="{Binding SizeLabel}" Width="95" /><DataGridTextColumn Header="FILA" ElementStyle="{StaticResource TableText}" Binding="{Binding StateLabel}" Width="110" /><DataGridTextColumn Header="DIAGNÓSTICO" ElementStyle="{StaticResource TableText}" Binding="{Binding Conclusion}" Width="1.6*" /></DataGrid.Columns></DataGrid>
              <DockPanel Grid.Row="2" Margin="18,4"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Anterior" Click="Previous_Click" Style="{StaticResource Secondary}" Padding="12,5" Margin="0,0,6,0" /><Button Content="Próxima" Click="Next_Click" Style="{StaticResource Secondary}" Padding="12,5" /></StackPanel><TextBlock Text="Selecione um arquivo para ver detalhes e opções de recuperação." Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" /></DockPanel>
            </Grid></Border>
            <StackPanel Grid.Row="4" Margin="0,16,0,0"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="PauseButton" Content="Pausar após arquivo" Click="Pause_Click" Style="{StaticResource Secondary}" Padding="12,6" IsEnabled="False" Margin="0,0,8,0" /><Button x:Name="CancelButton" Content="Cancelar" Click="Cancel_Click" Background="{DynamicResource Nx.Navy}" Padding="12,6" IsEnabled="False" /></StackPanel><StackPanel><TextBlock x:Name="StageText" Text="Pronto para iniciar" FontWeight="SemiBold" /><TextBlock x:Name="CurrentFile" Text="A análise não altera os arquivos de origem." Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" /></StackPanel></DockPanel><ProgressBar x:Name="TotalProgress" Height="5" Margin="0,12,0,0" Foreground="{DynamicResource Nx.Blue}" Background="{DynamicResource Nx.Border}" /></StackPanel>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28"><TextBlock Text="Recuperação" FontSize="28" FontWeight="Bold" /><TextBlock Text="Gere um candidato separado e examine o novo diagnóstico. Nenhum original é substituído." Style="{StaticResource Muted}" Margin="0,6,0,24" />
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Arquivo selecionado" FontWeight="SemiBold" /><TextBlock x:Name="SelectedPath" Text="Selecione um arquivo na lista de análise." Style="{StaticResource Muted}" Margin="0,8,0,16" /><TextBlock Text="Pasta dos candidatos" /><DockPanel Margin="0,7,0,16"><Button DockPanel.Dock="Right" Content="Escolher" Style="{StaticResource Secondary}" Click="Output_Click" Margin="8,0,0,0" /><TextBox x:Name="OutputBox" /></DockPanel><TextBlock Text="Referência íntegra (opcional, mesma câmera e configuração)" /><DockPanel Margin="0,7,0,18"><Button DockPanel.Dock="Right" Content="Escolher" Style="{StaticResource Secondary}" Click="Reference_Click" Margin="8,0,0,0" /><TextBox x:Name="ReferenceBox" /></DockPanel><StackPanel Orientation="Horizontal"><Button x:Name="RemuxButton" Content="Gerar candidato por remux" Click="Remux_Click" Margin="0,0,10,0" /><Button x:Name="UntruncButton" Content="Untrunc com referência · experimental" Click="Untrunc_Click" Style="{StaticResource Secondary}" /></StackPanel><TextBlock x:Name="RepairStatus" Style="{StaticResource Muted}" Margin="0,16,0,0" Text="A criação de um arquivo reproduzível não garante reparo. Enxertos e operação na origem ainda indisponíveis." /></StackPanel></Border>
          <TextBlock Text="Detalhes do diagnóstico" FontSize="17" FontWeight="SemiBold" Margin="0,26,0,12" /><TextBox x:Name="DetailBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="370" FontFamily="{DynamicResource Nx.Mono}" Text="Nenhum arquivo selecionado." />
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32,28">
          <TextBlock Text="Relatórios e validação" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Avalie os mesmos arquivos e compare sua observação com os alertas da análise." Style="{StaticResource Muted}" Margin="0,6,0,24" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel x:Name="ReviewPanel">
            <TextBlock Text="Avaliação manual do original" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Reproduza o arquivo inteiro em seu player. A lista abaixo omite o diagnóstico para reduzir influência na avaliação. As páginas são as mesmas da análise." Style="{StaticResource Muted}" Margin="0,10,0,12" />
            <DataGrid x:Name="ReviewGrid" Height="180" SelectionMode="Single" SelectionChanged="Review_SelectionChanged" ItemsSource="{Binding ItemsSource, ElementName=ResultsGrid}"><DataGrid.Columns>
              <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Name}" ElementStyle="{StaticResource TableText}" Width="*" />
              <DataGridTextColumn Header="FILA" Binding="{Binding StateLabel}" ElementStyle="{StaticResource TableText}" Width="130" />
            </DataGrid.Columns></DataGrid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,12"><Button Content="Anterior" Click="Previous_Click" Style="{StaticResource Secondary}" Margin="0,0,8,0" /><Button Content="Próxima" Click="Next_Click" Style="{StaticResource Secondary}" /></StackPanel>
            <TextBlock x:Name="ReviewPath" Text="Selecione um arquivo já processado." Style="{StaticResource Muted}" Margin="0,0,0,12" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="Problema observado na reprodução" /><TextBlock Grid.Column="1" Text="Qualidade percebida" Margin="12,0,0,0" />
              <ComboBox x:Name="HumanVerdictBox" Grid.Row="1" SelectedIndex="0" Margin="0,6,0,12"><ComboBoxItem Content="Não avaliado" /><ComboBoxItem Content="Sem problema observado" /><ComboBoxItem Content="Problema observado" /><ComboBoxItem Content="Inconclusivo" /></ComboBox>
              <ComboBox x:Name="SatisfactionBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="12,6,0,12"><ComboBoxItem Content="Não avaliada" /><ComboBoxItem Content="Satisfatória" /><ComboBoxItem Content="Parcial" /><ComboBoxItem Content="Insatisfatória" /></ComboBox>
              <TextBlock Grid.Row="2" Text="Avaliador" /><TextBlock Grid.Row="2" Grid.Column="1" Text="Player e versão" Margin="12,0,0,0" />
              <TextBox x:Name="ReviewerBox" Grid.Row="3" Margin="0,6,0,12" MaxLength="200" /><TextBox x:Name="PlayerBox" Grid.Row="3" Grid.Column="1" Margin="12,6,0,12" MaxLength="200" />
            </Grid>
            <CheckBox x:Name="WholeFileCheck" Content="Reproduzi o arquivo inteiro, verificando áudio e vídeo presentes" Margin="0,0,0,12" />
            <CheckBox x:Name="CouldNotOpenCheck" Content="Não consegui iniciar a reprodução no player; registrei o sintoma nas notas" Margin="0,0,0,12" />
            <TextBlock Text="Onde ocorreu: trilha, minuto/segundo e sintoma (imagem, áudio, travamento, sincronia)" />
            <TextBox x:Name="ReviewNotesBox" Height="75" Margin="0,6,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="8000" />
            <Button x:Name="SaveReviewButton" Content="Salvar avaliação e conferir SHA-256" Click="SaveReview_Click" HorizontalAlignment="Left" />
            <TextBlock x:Name="ReviewStatus" Style="{StaticResource Muted}" Margin="0,10,0,0" Text="O registro só entra na comparação se pertencer aos mesmos bytes e tiver reprodução inteira ou falha confirmada ao abrir." />
          </StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Comparação e evidências da sessão" FontSize="17" FontWeight="SemiBold" />
            <TextBlock x:Name="ReportSummary" Style="{StaticResource Muted}" Margin="0,12,0,12" Text="Nenhuma sessão disponível." />
            <StackPanel Orientation="Horizontal"><Button Content="Calcular comparação" Click="Compare_Click" Style="{StaticResource Secondary}" Margin="0,0,12,0" /><Button Content="Exportar relatório completo JSON" Click="Export_Click" /></StackPanel>
            <TextBlock x:Name="ComparisonText" Style="{StaticResource Muted}" Margin="0,12,0,0" Text="Ainda sem comparação. Precisão, sensibilidade e acurácia aparecem quando há pares elegíveis." />
            <TextBlock Text="O JSON inclui avaliações, matriz de confusão, opções, hashes, trilhas, intervalos, comandos, mensagens e logs. Resultados sem base comparável e modo rápido não contam como acerto." Style="{StaticResource Muted}" Margin="0,12,0,0" />
          </StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsPanel" Margin="32,28"><TextBlock Text="Configurações" FontSize="28" FontWeight="Bold" /><TextBlock Text="Ferramentas externas, amostragem e limites da análise. A fila permanece sequencial." Style="{StaticResource Muted}" Margin="0,6,0,24" />
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Ferramentas multimídia" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" /><TextBlock Text="FFprobe.exe" /><DockPanel Margin="0,6,0,12"><Button Content="Escolher" DockPanel.Dock="Right" Tag="probe" Click="Tool_Click" Style="{StaticResource Secondary}" Margin="8,0,0,0" /><TextBox x:Name="ProbeBox" /></DockPanel><TextBlock Text="FFmpeg.exe" /><DockPanel Margin="0,6,0,12"><Button Content="Escolher" DockPanel.Dock="Right" Tag="mpeg" Click="Tool_Click" Style="{StaticResource Secondary}" Margin="8,0,0,0" /><TextBox x:Name="MpegBox" /></DockPanel><TextBlock Text="Untrunc.exe (opcional)" /><DockPanel Margin="0,6,0,0"><Button Content="Escolher" DockPanel.Dock="Right" Tag="untrunc" Click="Tool_Click" Style="{StaticResource Secondary}" Margin="8,0,0,0" /><TextBox x:Name="UntruncBox" /></DockPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Amostragem e recursos" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" /><UniformGrid Columns="3"><StackPanel Margin="0,0,12,12"><TextBlock Text="Distribuição das amostras" /><ComboBox x:Name="SamplingBox" SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem Content="Quantidade de amostras" /><ComboBoxItem Content="Intervalo aproximado em MB" /></ComboBox></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Quantidade (2 a 200)" /><TextBox x:Name="SampleCountBox" Text="20" Margin="0,6,0,0" /></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Segundos por amostra" /><TextBox x:Name="SecondsBox" Text="3" Margin="0,6,0,0" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Intervalo aproximado (MB)" /><TextBox x:Name="MegabytesBox" Text="20" Margin="0,6,0,0" /></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Timeout por subprocesso (s)" /><TextBox x:Name="TimeoutBox" Text="300" Margin="0,6,0,0" /></StackPanel><StackPanel Margin="0,0,0,12"><TextBlock Text="Threads internas do decoder" /><TextBox x:Name="ThreadsBox" Text="2" Margin="0,6,0,0" /></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Limite da árvore de processos (MB)" /><TextBox x:Name="MemoryBox" Text="2048" Margin="0,6,0,0" /></StackPanel></UniformGrid><WrapPanel Margin="0,12,0,0"><CheckBox x:Name="AudioCheck" Content="Analisar áudio" IsChecked="True" /><CheckBox x:Name="VideoCheck" Content="Analisar vídeo" IsChecked="True" /><CheckBox x:Name="RecursiveCheck" Content="Incluir subpastas" IsChecked="True" /></WrapPanel><TextBlock Text="MB representa uma estimativa de posição temporal. Janelas vazias ou limites atingidos geram diagnóstico inconclusivo." Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados locais" FontWeight="SemiBold" /><TextBlock x:Name="DataPathText" Style="{StaticResource Muted}" Margin="0,8,0,12" /><Button Content="Salvar configurações" Click="SaveSettings_Click" HorizontalAlignment="Left" /></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </Grid>
</Window>
